# =============================================================================
# .gitignore - Sistema IoT de Riego Automático
# =============================================================================

# Credenciales y variables de entorno REALES (NUNCA subir a Git)
.env
*.env.local
*.env.production

# Claves privadas TLS
certs/*.key
certs/ca.srl

# Base de datos SQLite
*.db
*.db-journal
*.db-wal
*.db-shm

# Logs
*.log
logs/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
venv/
.venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
