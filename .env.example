# =============================================================================
# .env.example - Plantilla de variables de entorno
# Sistema IoT de Riego Automático
# =============================================================================
# INSTRUCCIONES:
#   1. Copia este archivo como ".env" en la raíz del proyecto:
#        cp .env.example .env
#   2. Rellena cada valor con tus credenciales REALES.
#   3. NUNCA subas el archivo .env a Git (ya está en .gitignore).
#   4. NUNCA compartas este archivo con credenciales reales.
# =============================================================================

# -----------------------------------------------------------------------------
# BROKER MQTT
# -----------------------------------------------------------------------------

# Hostname del broker MQTT (broker privado recomendado en producción)
MQTT_BROKER=broker.emqx.io

# Puerto TLS (8883) o sin TLS (1883 — solo desarrollo)
MQTT_PORT=8883

# Credenciales de autenticación MQTT
MQTT_USER=tu_usuario_mqtt
MQTT_PASS=tu_contrasena_mqtt_segura

# ID único del cliente MQTT para este backend
MQTT_CLIENT_ID=VSCode_Backend_Listener

# Habilitar TLS (true/false) — SIEMPRE true en producción
MQTT_USE_TLS=true

# Tiempo de keepalive en segundos
MQTT_KEEPALIVE=60

# -----------------------------------------------------------------------------
# TELEGRAM BOT
# -----------------------------------------------------------------------------

# Token del bot generado con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff1234567890ab

# Chat ID del usuario/grupo que recibirá notificaciones
TELEGRAM_CHAT_ID=123456789

# IDs de Telegram autorizados para enviar comandos (separados por coma)
# El bot solo procesará comandos de estos IDs
AUTHORIZED_TELEGRAM_IDS=123456789,987654321

# -----------------------------------------------------------------------------
# TÓPICOS MQTT
# -----------------------------------------------------------------------------

# Prefijo base de los tópicos (sin barra al final)
MQTT_TOPIC_PREFIX=hogar/planta01

# -----------------------------------------------------------------------------
# TLS / CERTIFICADOS
# -----------------------------------------------------------------------------

# Ruta al directorio de certificados (relativa o absoluta)
CERTS_DIR=./certs

# Ruta al certificado de la CA (Certificate Authority)
TLS_CA_CERT=./certs/ca.crt

# Certificado del cliente (para autenticación mutua TLS — opcional)
TLS_CLIENT_CERT=./certs/client.crt

# Clave privada del cliente (para autenticación mutua TLS — opcional)
TLS_CLIENT_KEY=./certs/client.key

# Versión TLS mínima (TLSv1_2 recomendado; TLSv1_3 si el broker lo soporta)
TLS_VERSION=TLSv1_2

# En desarrollo con certificados auto-firmados puede ser true
# NUNCA true en producción
TLS_INSECURE=false

# -----------------------------------------------------------------------------
# BASE DE DATOS
# -----------------------------------------------------------------------------

DB_NAME=riego_iot.db

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

LOG_LEVEL=INFO
LOG_FILE=riego_iot.log
